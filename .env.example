# Supabase (user data only — never copy books here)
#
# Required for auth + projects:
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_or_anon_key

# Optional alias supported by the app (legacy name):
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NEVER prefix with NEXT_PUBLIC_. Never commit real values.
# SUPABASE_SERVICE_ROLE_KEY=

# Optional absolute URL for auth email redirects in production:
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
